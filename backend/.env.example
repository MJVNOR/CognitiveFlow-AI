DATABASE_URL=sqlite:///./cognitiveflow.db
LLM_PROVIDER=gemini
LLM_MODEL=
# Google AI Studio (Gemini API): GEMINI_API_KEY. Vertex AI usa GOOGLE_API_KEY.
# main.py lee GEMINI_API_KEY con fallback a GOOGLE_API_KEY.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Jev: EVALUATOR_MODE=mock (default, tests/demo) o =jev (solo ml_experiment).
# Proveedor jev-api.org (https://jev-api.org/jev-python): key del dashboard
# (jeva_...; no valen keys de TypeSafe console). Alternativas TYPESAFE_*.
# Modelo default jev-latest; override con JEV_MODEL.
JEV_API_KEY=
TYPESAFE_API_KEY=
JEV_BASE_URL=
TYPESAFE_BASE_URL=https://jev-api.org
JEV_MODEL=
EVALUATOR_MODE=mock
CORS_ORIGINS=http://localhost:8080
AUTH_SECRET=
DEMO_MODE=false
