# Copiar a .env (nunca commitear el .env real). Valores de ejemplo, no claves.
# Backend lee estas variables (ver app/: main, db, evaluation, socratic, helpers).

# SQLite local (default si se omite). En Render apunta al disco persistente.
DATABASE_URL=sqlite:///./cognitiveflow.db

# Orígenes permitidos por CORS (coma-separados, sin espacios).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Tutor Gemini (opcional; sin key usa mock etiquetado, cero costo).
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alternativa aceptada
LLM_MODEL=gemini-3.8-flash

# Evaluador Jev (opcional; sin key queda en mock. Solo ML usa Jev).
EVALUATOR_MODE=mock
# JEV_API_KEY=
# TYPESAFE_API_KEY=  # alternativa aceptada
# JEV_BASE_URL=https://jev-api.org
# JEV_MODEL=jev-latest

# Solo tests: 1 para permitir 1 llamada live opt-in (nunca en CI).
# JEV_LIVE_TEST=
